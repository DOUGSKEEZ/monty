[Unit]
Description=Daily yt-dlp update check

[Timer]
# Run daily at 4 AM (quiet hours). Daily (vs weekly) keeps yt-dlp fresh against
# mid-week YouTube breakages; the script's API pre-check makes a no-op run cheap
# (a HEAD request, not a 40MB download).
OnCalendar=*-*-* 04:00:00
# Run immediately if we missed a scheduled run (e.g., system was off)
Persistent=true
# Add random delay up to 30 min to avoid thundering herd
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target
